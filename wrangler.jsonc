{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doni-transportes",
  "account_id": "85ac00e7b92503f8542b08eca7803e30",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/openapi.json",
      "/health"
    ]
  },
  "vars": {
    "API_ORIGIN": "https://doni-transportes-api.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
