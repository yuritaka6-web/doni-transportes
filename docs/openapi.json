  "components": {
    "schemas": {
      "Identificador": {
        "type": "string",
        "description": "Identificador UUID imutável gerado pelo servidor.",
        "example": "a2385741-58e7-4eaf-a31c-6a4e7b8a12ab",
        "format": "uuid",
        "x-apidog-mock": "{{$string.uuid}}"
      },
      "DataHora": {
        "type": "string",
        "description": "Instante em UTC no formato RFC 3339.",
        "example": "2026-11-20T15:00:00.000Z",
        "format": "date-time",
        "x-apidog-mock": "{{$date.recent}}"
      },
      "TipoPessoa": {
        "type": "string",
        "description": "PF: pessoa física; PJ: pessoa jurídica.",
        "example": "PJ",
