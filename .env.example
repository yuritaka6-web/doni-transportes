# Copie para .env. Nao publique .env nem envie senhas pelo chat.
PORT=3000
COMPANY_EMAIL=yuri.taka6@gmail.com
# Gmail SMTP: use uma conta remetente com verificacao em duas etapas e senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Preencha SMTP_USER e MAIL_FROM com a conta remetente, e SMTP_PASS com a senha de app.
# Sem estes campos, a API salva o pedido e mantem a notificacao PENDENTE.
